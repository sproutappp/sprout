rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each document is keyed by the owning Firebase Auth UID. A user can
    // only read or write their OWN document — request.auth.uid must
    // match the document id exactly. This is what makes it safe for the
    // client to read its own stashed Supabase password back: nobody can
    // read anyone else's phone_auth_vault entry, verified or not.
    match /phone_auth_vault/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Explicit deny-all for everything else. Firestore already denies
    // unmatched paths by default, but this is here so a future
    // collection added to this database doesn't accidentally inherit
    // looser rules from a change made without reading this file fully.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
